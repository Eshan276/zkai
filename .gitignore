# Dependencies
node_modules/
*/node_modules/
**/.venv/

# Build artifacts
*/dist/
*/build/
contracts/out/

# Compiled contract artifacts (generated by compact compiler)
deploy/compiled/

# Secrets — never commit
deploy/.seed
deploy/.bridge-seed
*.seed
