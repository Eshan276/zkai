.env*

# Deployment state
deployment.json
deploy/deployment.json

# LevelDB wallet state
midnight-level-db/
*/midnight-level-db/

# Model weights
provider/models/*
!provider/models/.cache/huggingface/.gitignore

# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
*.whl

# Logs
*.log

# Build output
dist/
.build-tmp/

# OS
.DS_Store
